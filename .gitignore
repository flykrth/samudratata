# =============================================================================
# samudratata — .gitignore
# =============================================================================

# ── Virtual environment ──────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Credentials – NEVER commit these ────────────────────────────────────────
.env
*.json.key
*service-account*.json

# ── Large data files (keep directory scaffolds via .gitkeep) ─────────────────
data/**
!data/
!data/**/
!data/**/.gitkeep
!data/coastline/
!data/coastline/**
!data/graph_schema.json
!data/dataset_card.md
!data/coastal_graph_topology.png
!data/vulnerability_map.png
!data/digital_twin_gnn_summary.json
!data/south_india_coastal_graph.pt
!data/loss_curve.png

# Raw raster / netCDF / archive formats
*.tif
*.tiff
*.jp2
*.nc
*.h5
*.hdf5
*.zip

# ── Model weights ────────────────────────────────────────────────────────────
# Small checkpoints (< 100 MB) ARE tracked under weights/
weights/**
!weights/
!weights/.gitkeep
!weights/digital_twin_gnn_best.pt
!weights/surge_lstm_best.pt

# Large checkpoints that exceed GitHub 100 MB limit — distribute via Releases
data/autoencoder_best.pt
data/changeformer_coastal_best.pt
data/latent_embeddings.pt
data/latent_embeddings.h5
data/autoencoder_best.pt

# ── ChangeFormer submodule checkpoints ───────────────────────────────────────
ChangeFormer/checkpoints/
ChangeFormer/checkpoints/**

# ── Experiment tracking ──────────────────────────────────────────────────────
wandb/

# ── Python artifacts ─────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── LaTeX auxiliary files ───────────────────────────────────────────────────
*.aux
*.log
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk
*.out
