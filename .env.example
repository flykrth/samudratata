# ─────────────────────────────────────────────────────────────────
# Sentinel-2 DL Project  |  Environment Variables Template
# Copy this file to .env and fill in your real credentials.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────

# ── Option A: Copernicus Data Space Ecosystem (CDSE) ──────────────
# Register at: https://dataspace.copernicus.eu
CDSE_USER=your_cdse_username_or_email
CDSE_PASSWORD=your_cdse_password

# ── Option B: Google Earth Engine (GEE) ───────────────────────────
# Service-account JSON key path (preferred for non-interactive/CI)
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_KEY_FILE=/path/to/your/gee-service-account-key.json

# GEE project ID (required since earthengine-api >= 0.1.370)
GEE_PROJECT=your-gcp-project-id

# ── Shared project settings ───────────────────────────────────────
# Preferred auth backend: "cdse" | "gee"
AUTH_BACKEND=gee

# Output directory for downloaded imagery
DATA_DIR=./data/sentinel2

# Date range for the DL dataset
DATE_START=2019-01-01
DATE_END=2024-12-31

# Maximum cloud cover percentage (0-100)
MAX_CLOUD_COVER=20
